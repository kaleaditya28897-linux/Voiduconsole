#!/bin/sh
# uconsole-osd-vol -- bump PulseAudio volume and update the wob OSD bar.
# Usage: uconsole-osd-vol up|down|mute
set -eu

WOB_SOCK="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"

case "${1:-up}" in
  up)   pamixer -i 5 ;;
  down) pamixer -d 5 ;;
  mute) pamixer -t ;;
  *)    echo "usage: $0 up|down|mute" >&2; exit 1 ;;
esac

if pamixer --get-mute | grep -q true; then
  printf '0\n' > "$WOB_SOCK" 2>/dev/null || true
else
  vol=$(pamixer --get-volume)
  printf '%s\n' "$vol" > "$WOB_SOCK" 2>/dev/null || true
fi
