#!/bin/sh
# uconsole-osd-bri -- adjust backlight via uconsole-brightness and update wob.
# Usage: uconsole-osd-bri up|down
set -eu

WOB_SOCK="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"

case "${1:-up}" in
  up)   uconsole-brightness up   >/dev/null 2>&1 || brightnessctl set +10%  >/dev/null ;;
  down) uconsole-brightness down >/dev/null 2>&1 || brightnessctl set 10%-  >/dev/null ;;
  *)    echo "usage: $0 up|down" >&2; exit 1 ;;
esac

# Read current brightness as a percent from sysfs (works regardless of helper).
bdir=$(ls -d /sys/class/backlight/* 2>/dev/null | head -1 || true)
if [ -n "${bdir:-}" ] && [ -r "$bdir/brightness" ] && [ -r "$bdir/max_brightness" ]; then
  cur=$(cat "$bdir/brightness")
  max=$(cat "$bdir/max_brightness")
  pct=$(( cur * 100 / max ))
  printf '%s\n' "$pct" > "$WOB_SOCK" 2>/dev/null || true
fi
