#!/bin/bash
# uconsole-brightness: tiny wrapper around brightnessctl mapping the
# uConsole Fn+arrow keys ("<" / ">") to backlight steps.
set -euo pipefail
case "${1:-}" in
  up)   brightnessctl s 10%+ ;;
  down) brightnessctl s 10%- ;;
  set)  brightnessctl s "${2:?need percentage}" ;;
  *)    brightnessctl ;;
esac
