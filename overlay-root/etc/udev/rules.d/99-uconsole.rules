# SIM7600G AT ports & GPS: let the user group read/write so the call TUI works
SUBSYSTEM=="tty", ATTRS{idVendor}=="1e0e", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2c7c", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", GROUP="dialout", MODE="0660"

# Battery (AXP209/PMU on uConsole) charge tuning
KERNEL=="axp20x-battery", ATTR{constant_charge_current_max}="2200000", ATTR{constant_charge_current}="2000000"

# Allow the wheel/video group to twiddle backlight via brightnessctl without sudo
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"

# libgpiod access for the wheel group (needed for /usr/local/bin/uconsole-4g)
KERNEL=="gpiochip*", GROUP="wheel", MODE="0660"
