{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 4,
  "modules-left":   ["wlr/taskbar", "custom/4g"],
  "modules-center": ["clock"],
  "modules-right":  ["idle_inhibitor", "network", "pulseaudio", "backlight", "battery", "tray"],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 14,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "clock":      { "format": "{:%a %d  %H:%M}", "tooltip-format": "{:%Y-%m-%d %H:%M:%S}" },
  "battery":    { "format": "{capacity}% {icon}", "format-charging": "{capacity}% ", "format-icons": ["", "", "", "", ""], "states": { "warning": 25, "critical": 10 } },
  "network":    { "format-wifi": " {signalStrength}%", "format-ethernet": "", "format-disconnected": "睊", "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}" },
  "pulseaudio": { "format": "{volume}% {icon}", "format-muted": "婢", "format-icons": ["", "", ""], "on-click": "pavucontrol" },
  "backlight":  { "format": "{percent}% " },
  "idle_inhibitor": { "format": "{icon}", "format-icons": { "activated": "", "deactivated": "" } },
  "tray":       { "spacing": 6, "icon-size": 14 },
  "custom/4g":  { "exec": "mmcli -L 2>/dev/null | grep -q Modem && echo  4G || echo ", "interval": 10, "on-click": "footclient -T 4G sh -c 'sudo uconsole-4g on; read'" }
}
