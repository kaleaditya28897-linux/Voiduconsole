# swayidle config for the uConsole handheld.
#
# Numbers are tuned for "reading on the couch" -- the panel stays on for
# 5 minutes of inactivity, dims after that, locks after 10, and only powers
# down the DPMS link after 15. Lid/close events would go here too, but the
# uConsole has no lid switch.
#
# Invoked from labwc autostart as:
#   swayidle -w -C ~/.config/swayidle/config &

timeout 300 'brightnessctl -s set 20%' \
  resume        'brightnessctl -r'

timeout 600 'swaylock -f -c 000000'

timeout 900 'wlr-randr --output DSI-1 --off' \
  resume        'wlr-randr --output DSI-1 --on'

before-sleep 'swaylock -f -c 000000'
